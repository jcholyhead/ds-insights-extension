{
  "manifest_version": 3,
  "name": "Dreaming Insights Extension",
  "version": "1.0",
  "description": "Captures watchedVideo, externalTime and dayWatchedTime API responses on app.dreaming.com/spanish/progress",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.dreaming.com/*",
    "https://dreaminginsights.com/*",
    "https://www.dreaminginsights.com/*",
    "http://localhost:5174/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.dreaming.com/spanish/progress*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dreaminginsights.com/*",
        "https://www.dreaminginsights.com/*",
        "http://localhost:5174/*"
      ],
      "js": ["detect-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dreaminginsights.com/*",
        "https://www.dreaminginsights.com/*",
        "http://localhost:5174/*"
      ],
      "js": ["paste-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dreaming Insights"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://app.dreaming.com/*"]
    },
    {
      "resources": ["privacy.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
